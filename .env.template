# ==========================================
# LazyScheduler Environment Configuration
# ==========================================

# 1. Groq LLM API Key (Required for natural language parsing & task decomposition)
# Get a free key at: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# 2. Google OAuth Credentials (Optional fallback if not using credentials.json)
GOOGLE_CLIENT_ID=your_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret_here
GOOGLE_PROJECT_ID=lazy-scheduler
